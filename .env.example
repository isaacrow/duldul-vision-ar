# Masar Iraq (مسار العراق) - Environment Configuration

# Server Port
PORT=3000

# Routing Provider Configuration
# Set MAPBOX_ACCESS_TOKEN to enable official Mapbox driving-traffic routing with real-time congestion annotations.
# If left blank, the app operates in open fallback mode using OpenStreetMap / OSRM.
MAPBOX_ACCESS_TOKEN=

# Routing Provider Choice: 'auto' (prefers Mapbox if token exists, falls back to OSRM), 'mapbox', or 'osrm'
ROUTING_PROVIDER=auto

# Security: Allowed CORS Origins (comma-separated, or * for development)
ALLOWED_ORIGINS=*

# Optional Data Storage Path (defaults to data/incidents.json)
# INCIDENTS_FILE=data/incidents.json
